{
  "description": "Inject active STE rules and gate writes, edits, and git commit messages.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/src/cli/main.ts\" hook",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/src/cli/main.ts\" hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
